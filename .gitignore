# Don't check auto-generated stuff into git
**/build
**/dist
**/*.tsbuildinfo
**/coverage
**/node_modules
**/.venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
package-lock.json
**/stats.json
**/src/index.css
**/src/index.css.map
**/yarn.lock

# per-version local secrets (see */config.example.js or .env.example)
**/config.js
**/.env

# Cruft
.DS_Store
.AppleDouble
.LSOverride

# Files and Caching
/.sass-cache

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Thumbnails
._*
Thumbs.db

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Logs
npm-debug.log*
testem.log*
yarn-debug.log*
yarn-error.log*

# OS or Editor folders
/.idea
.project
.classpath
.c9/
*.launch
.settings/
.cache
.project
.settings
.tmproj
*.esproj
nbproject
*.sublime-project
*.sublime-workspace
.idea

# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.zip
*.vi
*~

