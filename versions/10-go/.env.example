# Copy this file to .env (gitignored) and fill in a real Last.fm API key.
# Get one at https://www.last.fm/api/account/create
#
# This key is read server-side only (os.Getenv) and is never sent to the browser.
LASTFM_API_KEY=YOUR_LASTFM_API_KEY

# Optional overrides:
# LASTFM_API_ROOT=https://ws.audioscrobbler.com/2.0/
# PORT=8080
