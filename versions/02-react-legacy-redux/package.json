{
  "name": "albumcovers-react",
  "description": "Album covers code sample",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": ">=3",
    "node": ">=6"
  },
  "author": "Jonathan Boho",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jboho/albumcovers-react"
  },
  "scripts": {
    "prebuild:css": "sass src/scss/index.scss src/index.css",
    "build:css": "postcss src/index.css --use autoprefixer -o src/index.css",
    "watch:css": "sass src/scss/index.scss src/index.css --watch",
    "prebuild": "npm run build:clean",
    "build": "npm-run-all build:css build:js",
    "build:js": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "build:clean": "rimraf ./build",
    "clean": "npm run build:clean",
    "lint": "eslint --ext .js --ext .jsx src/",
    "lint:fix": "eslint --ext .js --ext .jsx --fix src/",
    "slate": "rimraf package-lock.json && rimraf node_modules && npm install",
    "start": "npm-run-all -p watch:css start:js",
    "start:js": "cross-env NODE_OPTIONS=--openssl-legacy-provider CHOKIDAR_USEPOLLING=true PORT=4444 react-scripts start",
    "test": "react-scripts test --env=jsdom"
  },
  "dependencies": {
    "axios": "0.19.0",
    "core-js": "3.4.7",
    "humps": "2.0.1",
    "lodash.isempty": "4.4.0",
    "lodash.isfunction": "3.0.9",
    "normalizr": "3.4.1",
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "react-redux": "7.1.3",
    "redux": "4.0.4",
    "redux-thunk": "2.3.0",
    "regenerator-runtime": "0.13.3"
  },
  "devDependencies": {
    "chai": "4.2.0",
    "chai-enzyme": "1.0.0-beta.1",
    "cheerio": "0.22.0",
    "cross-env": "6.0.3",
    "enzyme": "3.10.0",
    "enzyme-adapter-react-16": "1.15.1",
    "eslint-config-airbnb": "18.0.1",
    "eslint-config-airbnb-base": "14.0.0",
    "eslint-config-prettier": "6.7.0",
    "eslint-plugin-import": "2.18.2",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react": "7.17.0",
    "npm-run-all": "4.1.5",
    "react-dev-utils": "10.0.0",
    "postcss-cli": "6.1.3",
    "react-scripts": "3.3.0",
    "react-test-renderer": "16.12.0",
    "rimraf": "3.0.0",
    "sass": "1.77.8"
  },
  "overrides": {
    "cheerio": "0.22.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
